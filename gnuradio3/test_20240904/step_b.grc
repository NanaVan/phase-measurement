- name: epy_block_0
  id: epy_block
  parameters:
    _source_code: "\"\"\"\nEmbedded Python Blocks:\n\nEach time this file is saved,\
      \ GRC will instantiate the first class it finds\nto get ports and parameters\
      \ of your block. The arguments to __init__  will\nbe the parameters. All of\
      \ them are required to have default values!\n\"\"\"\n\nimport numpy as np\n\
      from gnuradio import gr\n\n\nclass blk(gr.sync_block):  # other base classes\
      \ are basic_block, decim_block, interp_block\n    \"\"\"Python Block to change\
      \ signal 0 to signal 1 based on the pulse\"\"\"\n\n    def __init__(self): \
      \ # only default arguments here\n        gr.sync_block.__init__(\n         \
      \   self,\n            name='Signal Switch',   # will show up in GRC\n     \
      \       in_sig=[np.complex64,np.complex64,np.int32],\n            out_sig=[np.complex64]\n\
      \        )\n        \n\n    def work(self, input_items, output_items):\n   \
      \     \"\"\"pulse 1: signal 0 on, signal 1 off; pulse -1: signal 0 off, signal\
      \ 1 off\"\"\"\n        if input_items[2][0] == 1:\n            output_items[0][:]\
      \ = input_items[0]\n        else:\n            output_items[0][:] = input_items[1]\n\
      \        return len(output_items[0])\n"
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache: ('Signal Switch', 'blk', [], [('0', 'complex', 1), ('1', 'complex',
      1), ('2', 'int', 1)], [('0', 'complex', 1)], 'Python Block to change signal
      0 to signal 1 based on the pulse', [])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [384, 232.0]
    rotation: 0
    state: enabled
