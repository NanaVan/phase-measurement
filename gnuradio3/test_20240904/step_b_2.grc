- name: bin_select
  id: epy_module
  parameters:
    alias: ''
    comment: ''
    source_code: "# this module will be imported in the into your flowgraph\nimport\
      \ numpy as np\n\ndef select_binNum(samp_rate, point_size, freq):\n    freq_range\
      \ = np.linspace(-samp_rate/2, samp_rate/2, num=point_size)\n    bin_num = np.searchsorted(freq_range,\
      \ freq, side='left')\n    if bin_num >= len(freq_range):\n        bin_num -=\
      \ 1\n    return bin_num\n"
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1104, 604.0]
    rotation: 0
    state: enabled
